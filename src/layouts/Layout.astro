---
import "../styles/base.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | GPM Docs</title>
	</head>
	<body>
		<div class="flex flex-row justify-between pt-10 h-full">
			<div></div>
			<div class="main-content">
				<slot />
			</div>
			<div></div>
		</div>
	</body>
</html>

<style is:global>
	.main-content {
		@apply max-w-hd w-full min-h-max bg-slate-900 rounded-3xl rounded-b-none p-6 border-slate-300 border-2 border-opacity-10 border-b-0 bg-opacity-75 flex flex-col;
	}
</style>
